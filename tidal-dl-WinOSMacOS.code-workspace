{
  "folders": [
    { "path": "." },                    // root repo: C:\PythonProjects\tidal-dl-WinOSMacOS
    // { "path": "Tidal-Media-Downloader" }, // code, but git-ignored by VS Code
    // { "path": "AIGPY" }                   // code, but git-ignored by VS Code
  ],
  "settings": {
    // ────────────── Git ──────────────
    "git.enabled": true,
    "git.autoRepositoryDetection": "subFolders",
    "git.openRepositoryInParentFolders": "always",
    "git.ignoredRepositories": [
      "${workspaceFolder}/Tidal-Media-Downloader",
      "${workspaceFolder}/AIGPY"
    ],

    // 👇 show files even if .gitignore says to ignore them
    "explorer.excludeGitIgnore": false,

    // ────────────── File Exclusions ──────────────
    "files.exclude": {
      "**/.git_disabled": true,
      "**/.history": true,
      "**/.lh": true,
      "**/.roo": false,
      "**/.venv": false,   // <— show .venv
      "**/.vscode": false,
      "**/backup": false,
      "**/cache": true,
      "**/download": false,
      "AIGPY/.git_disabled": true,
      "AIGPY/__pycache__": true,
      "AIGPY/aigpy/__pycache__": true,
      "Tidal-Media-Downloader/build": true,
      "Tidal-Media-Downloader/dist": false,
      "Tidal-Media-Downloader/__pycache__": true,
      "Tidal-Media-Downloader/TIDALDL-PY/tidal_dl/__pycache__": true
    },

    // ────────────── Search Exclusions ──────────────
    "search.exclude": {
      "**/.git_disabled": true,
      "**/.history": true,
      "**/.lh": true,
      "**/.roo": true,
      "**/.venv": false,
      "**/.vscode": true,
      "**/backup": true,
      "**/cache": true,
      "**/download": true,
      "AIGPY/.git_disabled": true,
      "AIGPY/__pycache__": true,
      "AIGPY/aigpy/__pycache__": true,
      "Tidal-Media-Downloader/build": true,
      "Tidal-Media-Downloader/dist": true,
      "Tidal-Media-Downloader/__pycache__": true,
      "Tidal-Media-Downloader/TIDALDL-PY/tidal_dl/__pycache__": true
    },

    // ────────────── Watcher Exclusions ──────────────
    "files.watcherExclude": {
      "**/.git_disabled/**": true,
      "**/.history/**": true,
      "**/.lh/**": true,
      "**/.roo/**": true,
      "**/.venv/**": true,
      "**/.vscode/**": true,
      "**/backup/**": true,
      "**/cache/**": true,
      "**/download/**": true,
      "AIGPY/.git_disabled/**": true,
      "AIGPY/__pycache__/**": true,
      "AIGPY/aigpy/__pycache__/**": true,
      "Tidal-Media-Downloader/build/**": true,
      "Tidal-Media-Downloader/dist/**": true,
      "Tidal-Media-Downloader/__pycache__/**": true,
      "Tidal-Media-Downloader/TIDALDL-PY/tidal_dl/__pycache__/**": true
    },

    // ────────────── Python / Pylance ──────────────
    "python.defaultInterpreterPath": "{workspaceFolder}/.venv",
    "python.analysis.exclude": [
      "**/.history",
      "**/.lh",
      "**/.roo",
      "**/backup",
      "**/cache",
      "**/download",
      "**/Tidal-Media-Downloader/build",
      "**/Tidal-Media-Downloader/dist"
    ],

    // make Pylance index the local packages first
    "python.analysis.extraPaths": [
      "Tidal-Media-Downloader/TIDALDL-PY",
      "AIGPY"
    ],

    // strict type-checking level
    "python.analysis.typeCheckingMode": "standard",

    // diagnostics tweaks
    "python.analysis.diagnosticSeverityOverrides": {
      "reportMissingImports": "error",
      "reportMissingTypeStubs": "none"
    },
    "python.analysis.autoSearchPaths": true,
    "python.analysis.useLibraryCodeForTypes": true,

    // auto-activate venv in terminals
    "python.terminal.activateEnvironment": true,
    "task.allowAutomaticTasks": "on"
  }
}
